{
  "manifest_version": 3,
  "name": "Element Inspector",
  "version": "0.5.0",
  "description": "Inspect a right-clicked page element and copy the DOM snapshot as formatted JSON.",
  "icons": {
    "16": "assets/icons/context-menu-icon-16.png",
    "32": "assets/icons/context-menu-icon-32.png",
    "48": "assets/icons/main-icon.png",
    "128": "assets/icons/main-icon.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/icons/main-icon.png",
      "32": "assets/icons/main-icon.png",
      "48": "assets/icons/main-icon.png",
      "128": "assets/icons/main-icon.png"
    },
    "default_title": "Element Inspector"
  },
  "permissions": [
    "contextMenus",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "inspector.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
